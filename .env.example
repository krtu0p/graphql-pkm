# Server
HOST=127.0.0.1
PORT=8080
ENVIRONMENT=development

# Database ("sqlite" or "mysql")
DB_DRIVER=sqlite
DB_PATH=./data/pkm.db
DATABASE_URL=root:password@tcp(localhost:3306)/pkm?parseTime=true

# AI configuration (defaults to local Ollama; set AI_ENABLED=false to disable)
AI_ENABLED=true
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=llama3.2
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text
SEMANTIC_THRESHOLD=0.6
