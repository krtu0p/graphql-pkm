scalar Time

type Note {
  id: ID!
  title: String!
  content: String!
  tags: [String!]!
  createdAt: Time!
  updatedAt: Time!
  summary: String
  keyConcepts: [String!]!
  links: [Link!]!
  backlinks: [Link!]!
}

type Link {
  id: ID!
  sourceNoteId: ID!
  targetNoteId: ID!
  description: String
  createdAt: Time!
}

type Backlink {
  id: ID!
  sourceNote: Note!
  description: String
  createdAt: Time!
}

type SearchResult {
  note: Note!
  score: Float!
  reason: String!
  matchType: String!
}

type SmartSearchResponse {
  results: [SearchResult!]!
  explanation: String!
  gaps: [String!]!
  connections: [String!]!
}

type AISettings {
  enabled: Boolean!
  provider: String!
  baseUrl: String!
  model: String!
  hasApiKey: Boolean!
  embedBaseUrl: String!
  embedModel: String!
}

type AIModelList {
  models: [String!]!
  error: String
}

input CreateNoteInput {
  title: String!
  content: String!
  tags: [String!]
}

input UpdateNoteInput {
  title: String
  content: String
  tags: [String!]
}

input SaveAISettingsInput {
  enabled: Boolean!
  provider: String!
  baseUrl: String!
  model: String!
  apiKey: String
  embedBaseUrl: String!
  embedModel: String!
}

input ListAIModelsInput {
  provider: String
  baseUrl: String!
  apiKey: String
}

type Query {
  notes: [Note!]!
  note(id: ID!): Note
  searchNotes(query: String!): [Note!]!
  notesByTag(tag: String!): [Note!]!
  backlinks(noteId: ID!): [Backlink!]!
  links(noteId: ID!): [Link!]!
  semanticSearch(query: String!): [SearchResult!]!
  smartSearch(query: String!): SmartSearchResponse!
  hybridSearch(query: String!): [SearchResult!]!
  checkRelationship(noteIDA: ID!, noteIDB: ID!): String!
  aiSettings: AISettings!
}

type Mutation {
  createNote(input: CreateNoteInput!): Note!
  updateNote(id: ID!, input: UpdateNoteInput!): Note!
  deleteNote(id: ID!): Boolean!
  linkNotes(sourceId: ID!, targetId: ID!, description: String): Link!
  unlinkNotes(linkId: ID!): Boolean!
  saveAISettings(input: SaveAISettingsInput!): AISettings!
  listAIModels(input: ListAIModelsInput!): AIModelList!
}

type Subscription {
  noteCreated: Note!
  noteUpdated: Note!
}